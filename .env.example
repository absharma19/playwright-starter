# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Target application URL (required)
BASE_URL=https://your-app-url.com

# API base URL for the request layer (optional — defaults to BASE_URL)
API_BASE_URL=https://your-app-url.com/api

# Login credentials for the auth setup project (optional — leave blank if the
# app needs no login; the setup step then saves an anonymous session).
APP_USERNAME=
APP_PASSWORD=

# Timeout overrides (optional — milliseconds)
TIMEOUT_LONG=60000
TIMEOUT_MEDIUM=30000
TIMEOUT_SHORT=5000

# If the default Playwright browser cache (~/.cache/ms-playwright) is not
# writable (e.g. owned by root), point to a user-owned directory:
# PLAYWRIGHT_BROWSERS_PATH=~/Library/Caches/playwright-browsers
